# Copy to .env and fill in. With no keys at all the engine runs in mock mode.

# --- LLM (auto = OpenAI if key set, else Anthropic if key set, else mock)
LLM_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# --- Search (auto = Serper if key set, else mock)
SEARCH_PROVIDER=auto
SERPER_API_KEY=

# --- Research loop caps
MAX_SUBTASKS=4
MAX_VERIFY_PASSES=2
MAX_FOLLOWUP_QUERIES=3
GRAPH_RECURSION_LIMIT=40

# --- Hard spend caps (per job)
JOB_TOKEN_BUDGET=60000
MAX_LLM_CALLS=30
MAX_SEARCH_CALLS=15
MAX_SCRAPE_CALLS=20
MAX_CONCURRENT_JOBS=2

# --- API / backend integration
# Set API_KEY before adding real LLM keys on a public URL
API_KEY=
# Signs callbacks: header X-Signature-256: sha256=<hmac>
WEBHOOK_SECRET=
DEFAULT_CALLBACK_URL=
DB_PATH=data/engine.db

# --- Outreach (dry run = record only, never send)
OUTREACH_DRY_RUN=true
OUTREACH_MAX_FOLLOWUPS_CAP=3
OUTREACH_MIN_INTERVAL_MINUTES=1
SCHEDULER_TICK_SECONDS=30
SENDGRID_API_KEY=
EMAIL_FROM=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=

# --- Keep-alive (Render free tier). Pings RENDER_EXTERNAL_URL/ping so the service
# doesn't sleep. Only runs when a public URL is known; minimum interval is 240 s.
KEEPALIVE_ENABLED=true
KEEPALIVE_INTERVAL_SECONDS=300
# Optional window like 7-23 (in KEEPALIVE_TIMEZONE) to let it sleep overnight; empty = always
KEEPALIVE_ACTIVE_HOURS=
KEEPALIVE_TIMEZONE=Asia/Kolkata
